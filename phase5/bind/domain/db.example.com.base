$TTL 600

@   IN  SOA domain-ns.example.com. admin.example.com. (
        1          ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        300        ; negative cache TTL
)

@           IN  NS  domain-ns.example.com.
domain-ns   IN  A   172.16.3.30

@           IN  A   172.16.1.20
www         IN  A   172.16.1.20

; Internal names used only for the Phase 5 zone-walking experiment.
admin       IN  A   172.16.1.20
api         IN  A   172.16.1.20
dev         IN  A   172.16.1.20
mail        IN  A   172.16.1.20
vpn         IN  A   172.16.1.20
