$TTL 600

@   IN  SOA tld-ns.com. admin.com. (
        1          ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        300        ; negative cache TTL
)

@                       IN  NS  tld-ns.com.
tld-ns                  IN  A   172.16.3.20

example.com.            IN  NS  domain-ns.example.com.
domain-ns.example.com.  IN  A   172.16.3.30
